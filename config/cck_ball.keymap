#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN >;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    leftLayer: leftLayer {
        compatible = "zmk,behavior-tap-dance";
        label = "LEFTLAYER";
        #binding-cells = <0>;
        bindings = <&mo 1>, <&mo 4>, <&togleComputer>;

        tapping-term-ms = <400>;
    };

    behaviors {
    };

    macros {
        togleComputer: togleComputer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LS(LA(LC(BACKSLASH)))>,
                <&macro_wait_time 300>,
                <&out OUT_TOG>;

            label = "TOGLECOMPUTER";
        };

        passkey: passkey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp G &kp Z &kp S &kp D &kp C &kp X &kp DOT &kp N1 &kp N2 &kp N1>,
                <&macro_wait_time 200>,
                <&kp ENTER>;

            label = "PASSKEY";
        };

        bt0: bt0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
            label = "BT0";
        };

        bt1: bt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
            label = "BT1";
        };

        bt2: bt2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
            label = "BT2";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC           &kp N1        &kp N2        &kp N3      &kp N4     &kp N5      &kp N6     &kp N7     &kp N8      &kp N9          &kp N0          &kp BACKSPACE
&kp TAB           &kp Q         &kp W         &kp E       &kp R      &kp T       &kp Y      &kp U      &kp I       &kp O           &kp P           &kp BSLH
&kp LS(LCTRL)     &kp A         &kp S         &kp D       &kp F      &kp G       &kp H      &kp J      &kp K       &kp L           &kp SEMI        &kp SQT
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C       &kp V      &kp B       &lt 3 N    &kp M      &kp COMMA   &kp DOT         &kp UP_ARROW    &kp FSLH
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &leftLayer  &kp SPACE  &kp DELETE  &mkp LCLK  &kp ENTER  &leftLayer  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;
        };

        F_layers {
            bindings = <
&kp GRAVE  &kp F1        &kp F2       &kp F3           &kp F4             &kp F5         &kp F6            &kp F7          &kp F8         &kp F9             &kp F10  &kp F11
&trans     &kp LS(F1)    &kp LS(F2)   &kp LS(F3)       &none              &kp LA(F4)     &none             &none           &kp LA(EQUAL)  &kp LS(F9)         &kp F11  &kp F12
&trans     &kp HOME      &kp END      &kp PAGE_UP      &kp PAGE_DOWN      &kp LC(LS(L))  &kp LEFT_BRACKET  &kp MINUS       &kp EQUAL      &kp RIGHT_BRACKET  &none    &mkp MB4
&trans     &kp LC(HOME)  &kp LC(END)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(GRAVE)  &kp LEFT_BRACE    &kp UNDERSCORE  &kp PLUS       &kp RIGHT_BRACE    &bt2     &mkp MB5
&trans     &trans        &trans       &trans           &trans             &passkey       &kp SPACE         &trans          &to 4          &bt0               &bt1     &out OUT_USB
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        MOUSE {
            bindings = <
&trans    &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans    &trans    &trans
&trans    &trans  &trans  &trans  &trans  &trans  &kp LC(W)  &trans     &trans     &trans    &trans    &trans
&kp CAPS  &trans  &trans  &trans  &trans  &trans  &mkp MB4   &mkp MB5   &trans     &trans    &trans    &trans
&trans    &trans  &trans  &trans  &trans  &trans  &trans     &mkp RCLK  &trans     &trans    &trans    &trans
&trans    &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &trans     &kp LC(W)  &mkp MB4  &mkp MB5  &trans
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp KP_NUMLOCK   &kp KP_DIVIDE    &kp STAR         &kp KP_MINUS
&trans  &trans          &trans        &trans        &trans        &trans        &trans                &trans                 &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans                &trans                 &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans        &trans                &trans                 &kp KP_NUMBER_2  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ENTER
&trans  &trans          &trans        &trans        &trans        &trans        &trans                &kp BACKSPACE          &to 1            &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_ENTER
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
